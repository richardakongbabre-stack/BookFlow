datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  STAFF
  PROVIDER_ADMIN
  PLATFORM_ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  phone        String?
  role         Role        @default(CUSTOMER)
  twoFactorSec String?     // Optional 2FA secret
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  bookings     Booking[]   @relation("CustomerBookings")
  staffProfile Staff?
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Provider {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String?
  logoUrl          String?
  phone            String?
  email            String?
  address          String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  subStatus        String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  commissionRate   Decimal          @default(0.0)      // e.g. 0.05 for 5%
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  staff            Staff[]
  services         Service[]
  bookings         Booking[]
  payments         Payment[]
}

model Staff {
  id           String      @id @default(uuid())
  userId       String      @unique
  providerId   String
  name         String
  title        String?
  bio          String?
  rating       Float       @default(5.0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  schedules    StaffSchedule[]
  exceptions   AvailabilityException[]
  services     StaffService[]
}

model Service {
  id          String      @id @default(uuid())
  providerId  String
  name        String
  description String?
  duration    Int         // Duration in minutes
  price       Decimal     // Price of the service
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  staff       StaffService[]
}

model StaffService {
  staffId   String
  serviceId String

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model StaffSchedule {
  id         String   @id @default(uuid())
  staffId    String
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, etc.
  startTime  String   // HH:MM format
  endTime    String   // HH:MM format

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model AvailabilityException {
  id         String   @id @default(uuid())
  staffId    String
  date       DateTime // Specific date
  isWorking  Boolean  @default(false) // If false, represents time off
  startTime  String?  // HH:MM format
  endTime    String?  // HH:MM format

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Booking {
  id               String        @id @default(uuid())
  providerId       String
  customerId       String
  staffId          String
  serviceId        String
  startTime        DateTime
  endTime          DateTime
  status           BookingStatus @default(PENDING)
  totalAmount      Decimal
  commissionAmount Decimal       @default(0.0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  provider         Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer         User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service          Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payments         Payment[]
}

model Payment {
  id                 String        @id @default(uuid())
  bookingId          String
  providerId         String
  amount             Decimal
  providerShare      Decimal
  platformCommission Decimal
  status             PaymentStatus @default(PENDING)
  transactionId      String?       // Stripe/PayPal reference ID
  gateway            String        @default("STRIPE") // STRIPE, PAYPAL
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider           Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // EMAIL, SMS
  status    String   // SENT, FAILED
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
